# Скопируйте этот файл в .env и заполните реальными значениями.
# Для локальной разработки достаточно значений по умолчанию.

# Обязательно на проде (config.settings.production)
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — обязателен на проде (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/studcareer

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email (SMTP для прода; в development работает console backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@studcareer.uz
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=noreply@studcareer.uz

# Отключить, если Nginx терминирует SSL и не проксирует https-заголовок
SECURE_SSL_REDIRECT=True
